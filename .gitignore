# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# SWF debug symbols
*.swd

# Flash recovery files
RECOVER_*.fla

# Jetbrains tools (CLion, IntelliJ, etc)
/.idea

# Mac junk
.DS_Store

# A developers local Flash Player harness config
.flash_players.toml

# Local developer tools & indexers
/.codegraph/
.tool-versions

# Apple / SwiftPM / Xcode build artifacts and user state
/apple-sdk/RuffleApple.xcframework/
**/.build/
**/.swiftpm/
**/xcuserdata/
*.xcuserstate
**/DerivedData/
